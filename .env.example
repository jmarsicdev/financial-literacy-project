POSTGRES_DB=financial_literacy
POSTGRES_USER=team5
POSTGRES_PASSWORD=local_dev_only

TAVILY_API_KEY=
# optional, prices come from yfinance when blank (the free key can't reach the adjusted endpoint anyway)
ALPHA_VANTAGE_API_KEY=
# ALPHA_VANTAGE_DAILY_LIMIT=25

# orchestrator (/ask): Qwen through the Hugging Face Inference API; a free HF account token is required
HF_TOKEN=
# LLM_PROVIDER=huggingface   # defaults to huggingface when HF_TOKEN is set, otherwise stub
# LLM_MODEL=Qwen/Qwen2.5-72B-Instruct
# local alternative, no token needed. Either the bundled compose service:
#   docker compose --profile local-llm up -d && docker compose exec ollama ollama pull qwen2.5:7b-instruct
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=http://ollama:11434/v1
# LLM_MODEL=qwen2.5:7b-instruct
# LLM_TIMEOUT_SECONDS=300        # CPU-only inference can take a few minutes per answer
# or an Ollama already running on the host: LLM_BASE_URL=http://host.docker.internal:11434/v1
# PUBLIC_API_URL=http://localhost:8000   # link shown for the risk-profile citation
# ASK_CACHE_TTL_SECONDS=86400            # /ask answers are kept in Redis this long (0 disables the cache)

# host-side cli only, compose sets the container's own
DATABASE_URL=postgresql://team5:local_dev_only@localhost:5433/financial_literacy
